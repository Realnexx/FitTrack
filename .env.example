# Browser-safe Supabase values from Project Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server runtime values (same public key, never a service-role key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Meal scanner: copy to a private .env.local for local development.
# Optional explicit server overrides when an integration provides another project:
# FITTRACK_SUPABASE_URL=https://your-project.supabase.co
# FITTRACK_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# FITTRACK_SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-key
# For Vercel, add these as server environment variables and redeploy.
# Never use the exposed key from chat, commit secrets, or prefix them with VITE_.
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEAL_SCAN_ENABLED=false
MEAL_SCAN_FREE_TIER_CONFIRMED=false
MEAL_SCAN_ELIGIBILITY_CONFIRMED=false
# Replace zero limits with verified allowances for your dedicated Free-tier project.
MEAL_SCAN_DAILY_LIMIT=0
MEAL_SCAN_USER_DAILY_LIMIT=0
MEAL_SCAN_RPM_LIMIT=0
MEAL_SCAN_TPM_LIMIT=0
